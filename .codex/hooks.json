{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "expected=107c43aa27e03257f3f92680b0627741a925d51b192e7c1c550cf7f48fc97ef5; python3 $HOME/.claude/hooks/dispatch.py --event pre --runtime codex",
            "commandWindows": "$expected='107c43aa27e03257f3f92680b0627741a925d51b192e7c1c550cf7f48fc97ef5'; py -3 $env:USERPROFILE/.claude/hooks/dispatch.py --event pre --runtime codex",
            "timeout": 5,
            "statusMessage": "Checking irreversible-command policy"
          }
        ]
      }
    ]
  }
}
