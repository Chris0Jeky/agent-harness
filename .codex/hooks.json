{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "expected=e68b8d0670986a8390df4aa42cbc90b354cfeab3b5e332246e3530896b9bdc0f; python3 \"$HOME/.claude/hooks/dispatch.py\" --event pre --runtime codex",
            "commandWindows": "$expected='e68b8d0670986a8390df4aa42cbc90b354cfeab3b5e332246e3530896b9bdc0f'; py -3 $env:USERPROFILE/.claude/hooks/dispatch.py --event pre --runtime codex",
            "timeout": 5,
            "statusMessage": "Checking irreversible-command policy"
          }
        ]
      }
    ]
  }
}
