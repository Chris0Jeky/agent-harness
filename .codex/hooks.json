{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "expected=e60f35d0f8e5b3e85e6ccc7f69c4923a5e90f2507e97e4dea0032bc083d2d85d; python $HOME/.claude/hooks/dispatch.py --event pre --runtime codex",
            "commandWindows": "$expected='e60f35d0f8e5b3e85e6ccc7f69c4923a5e90f2507e97e4dea0032bc083d2d85d'; py -3 $env:USERPROFILE/.claude/hooks/dispatch.py --event pre --runtime codex",
            "timeout": 5,
            "statusMessage": "Checking irreversible-command policy"
          }
        ]
      }
    ]
  }
}
