{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "expected=f5a5ea8ee0e7e970bb43d06c506caf1abb29369255c0de5282eaf10dd5c8c0ce; python3 \"$HOME/.claude/hooks/dispatch.py\" --event pre --runtime codex",
            "commandWindows": "$expected='f5a5ea8ee0e7e970bb43d06c506caf1abb29369255c0de5282eaf10dd5c8c0ce'; py -3 $env:USERPROFILE/.claude/hooks/dispatch.py --event pre --runtime codex",
            "timeout": 5,
            "statusMessage": "Checking irreversible-command policy"
          }
        ]
      }
    ]
  }
}
