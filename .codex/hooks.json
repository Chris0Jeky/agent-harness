{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "expected=b96c1e3e9fbc0cb05e60b60d1e548d149f729c363b9c09e3460ea5d0bf8440b0; python3 \"$HOME/.claude/hooks/dispatch.py\" --event pre --runtime codex",
            "commandWindows": "$expected='b96c1e3e9fbc0cb05e60b60d1e548d149f729c363b9c09e3460ea5d0bf8440b0'; py -3 $env:USERPROFILE/.claude/hooks/dispatch.py --event pre --runtime codex",
            "timeout": 5,
            "statusMessage": "Checking irreversible-command policy"
          }
        ]
      }
    ]
  }
}
