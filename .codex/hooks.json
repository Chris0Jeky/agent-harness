{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "expected=52ac1d1c08b7ff01e1ab9159e146a8c153288e38924a09c1d86c0c9b4b835ac8; python3 \"$HOME/.claude/hooks/dispatch.py\" --event pre --runtime codex",
            "commandWindows": "$expected='52ac1d1c08b7ff01e1ab9159e146a8c153288e38924a09c1d86c0c9b4b835ac8'; py -3 $env:USERPROFILE/.claude/hooks/dispatch.py --event pre --runtime codex",
            "timeout": 5,
            "statusMessage": "Checking irreversible-command policy"
          }
        ]
      }
    ]
  }
}
