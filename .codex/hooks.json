{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "expected=2f5c07e09bcfc403aa42fa3277e9bcd86df08f91da6c1789c3a231a3d3a1a410; python3 \"$HOME/.claude/hooks/dispatch.py\" --event pre --runtime codex",
            "commandWindows": "$expected='2f5c07e09bcfc403aa42fa3277e9bcd86df08f91da6c1789c3a231a3d3a1a410'; py -3 $env:USERPROFILE/.claude/hooks/dispatch.py --event pre --runtime codex",
            "timeout": 5,
            "statusMessage": "Checking irreversible-command policy"
          }
        ]
      }
    ]
  }
}
