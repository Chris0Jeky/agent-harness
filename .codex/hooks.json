{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "expected=0df0dba5cbfbb60a44955205e21bed42bdf0e8d2f76a02cfbd0829f91b7449c1; python3 \"$HOME/.claude/hooks/dispatch.py\" --event pre --runtime codex",
            "commandWindows": "$expected='0df0dba5cbfbb60a44955205e21bed42bdf0e8d2f76a02cfbd0829f91b7449c1'; py -3 $env:USERPROFILE/.claude/hooks/dispatch.py --event pre --runtime codex",
            "timeout": 5,
            "statusMessage": "Checking irreversible-command policy"
          }
        ]
      }
    ]
  }
}
