              "exit_bar": null,
              "approval": "until_graduated",
              "graduation": "p6-p7-graduation",
              "veto_days": 3,
              "channel": "pr"
            },
            "P7": {
              "live": true,
              "exit_bar": null,
              "approval": "per_promotion",
              "channel": "pr"
            }
          }
        }
      }
    }
  },
  "exit_bars": {
    "p1-shadow-exit": {
      "description": "P1 leaves shadow after 4 weeks in shadow, 50 judged candidates and precision of at least 0.90 on the sealed memory hold-out.",
      "shadow_days": 28,
      "judged_min": 50,
      "precision_min": 0.9,
      "suite": "memory-holdout"
    }
  },
  "graduations": {
    "p6-p7-graduation": {
      "description": "A class graduates once it has 3 approved promotions and 28 days have passed since the first of them, with no revert; a revert restarts the count.",
