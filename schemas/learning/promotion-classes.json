{
  "schema": "learning-promotion-classes/v1",
  "description": "Promotion classes P0-P8 as data. activation_gates must each hold a latest result of pass, from an accepted evaluator, before a candidate enters an activating state; conditional_gates add gates when the candidate sets that flag. Every class above P0 matures through probation before it activates. A live effect above P0 is resolved, never asserted: authority names which owner decision governs each class, decisions gives each answer option's meaning (live or shadow, exit bar, per-promotion approval, graduation, veto window, channel), and the fold checks the record's authority against a resolver's view of that decision on agent-hq origin/main. P8 is never automatic: an owner approval bound to the candidate sits on the record that turns it live and on the activating record. Contract: SPECS.md section 15.",
  "kind_class": {
    "episodic": "P0",
    "semantic": "P1",
    "consolidation": "P2",
    "skill": "P3",
    "prompt": "P4",
    "recipe": "P4",
    "routing": "P5",
    "scheduler": "P6",
    "harness": "P7",
    "policy": "P8"
  },
  "evaluators": {
    "never_satisfies": [
      "self"
    ],
    "independent": [
      "oracle",
      "owner",
      "independent_model"
    ],
    "owner_gate": [
      "owner"
    ],
    "not_judgment": [
      "maturity"
    ]
  },
  "classes": {
    "P0": {
      "label": "episodic",
      "creation": "autonomous",
      "offline_eval": "no",
      "canary": "no",
      "owner_approval": "no",
      "activation_gates": [],
      "conditional_gates": {},
      "owner_on_activation": false
    },
    "P1": {
      "label": "semantic memory",
      "creation": "autonomous",
      "offline_eval": "provenance and contradiction checks",
      "canary": "no",
      "owner_approval": "protected categories; live per decision lp-p1-memory-autopromote",
      "activation_gates": [
        "provenance",
        "contradiction",
        "maturity"
      ],
      "conditional_gates": {},
      "owner_on_activation": false
    },
    "P2": {
      "label": "consolidation",
      "creation": "autonomous",
      "offline_eval": "retrieval regression",
      "canary": "optional",
      "owner_approval": "no",
      "activation_gates": [
        "retrieval_regression",
        "maturity"
      ],
      "conditional_gates": {
        "protected": [
          "owner"
        ]
      },
      "owner_on_activation": false
    },
    "P3": {
      "label": "skill",
      "creation": "autonomous",
      "offline_eval": "yes",
      "canary": "consequential skills",
      "owner_approval": "no",
      "activation_gates": [
        "offline_eval",
        "maturity"
      ],
      "conditional_gates": {
        "consequential": [
          "canary"
        ],
        "protected": [
          "owner"
        ]
      },
      "owner_on_activation": false
    },
    "P4": {
      "label": "prompt, recipe",
      "creation": "autonomous",
      "offline_eval": "yes",
      "canary": "yes",
      "owner_approval": "no",
      "activation_gates": [
        "offline_eval",
        "canary",
        "maturity"
      ],
      "conditional_gates": {
        "protected": [
          "owner"
        ]
      },
      "owner_on_activation": false
    },
    "P5": {
      "label": "routing",
      "creation": "autonomous",
      "offline_eval": "historical replay",
      "canary": "yes",
      "owner_approval": "no",
      "activation_gates": [
        "replay",
        "canary",
        "maturity"
      ],
      "conditional_gates": {
        "protected": [
          "owner"
        ]
      },
      "owner_on_activation": false
    },
    "P6": {
      "label": "scheduler",
      "creation": "autonomous",
      "offline_eval": "strong comparative",
      "canary": "yes",
      "owner_approval": "per decision lp-p6-p7-owner-approval (answered b: approval until graduated, then a veto window)",
      "activation_gates": [
        "offline_eval",
        "canary",
        "maturity"
      ],
      "conditional_gates": {},
      "owner_on_activation": false
    },
    "P7": {
      "label": "harness, tool logic",
      "creation": "sandbox_only",
      "offline_eval": "strong",
      "canary": "yes",
      "owner_approval": "per decision lp-p6-p7-owner-approval (answered b: approval until graduated, then a veto window)",
      "activation_gates": [
        "offline_eval",
        "canary",
        "maturity"
      ],
      "conditional_gates": {},
      "owner_on_activation": false
    },
    "P8": {
      "label": "security, authority, policy",
      "creation": "proposal_only",
      "offline_eval": "tests",
      "canary": "never automatic",
      "owner_approval": "always",
      "activation_gates": [
        "tests",
        "maturity",
        "owner"
      ],
      "conditional_gates": {},
      "owner_on_activation": true
    }
  },
  "authority": {
    "P0": {
      "mode": "none"
    },
    "P1": {
      "mode": "decision",
      "decision": "lp-p1-memory-autopromote"
    },
    "P2": {
      "mode": "no_live",
      "why": "lp-p1-memory-autopromote decides P1 notes only; consolidation has no answered decision"
    },
    "P3": {
      "mode": "no_live"
    },
    "P4": {
      "mode": "no_live"
    },
    "P5": {
      "mode": "no_live"
    },
    "P6": {
      "mode": "decision",
      "decision": "lp-p6-p7-owner-approval"
    },
    "P7": {
      "mode": "decision",
      "decision": "lp-p6-p7-owner-approval"
    },
    "P8": {
      "mode": "per_promotion"
    }
  },
  "decisions": {
    "lp-p1-memory-autopromote": {
      "classes": [
        "P1"
      ],
      "options": {
        "a": {
          "live": false
        },
        "b": {
          "live": true,
          "exit_bar": "p1-shadow-exit",
          "approval": "none",
          "channel": "direct_lane",
          "protected_approval": true
        },
        "c": {
          "live": true,
          "exit_bar": "p1-shadow-exit",
          "approval": "none",
          "channel": "reviewed_pr",
          "protected_approval": true
        },
        "d": {
          "live": true,
          "exit_bar": null,
          "approval": "none",
          "channel": "direct_lane",
          "protected_approval": false
        }
      }
    },
    "lp-p6-p7-owner-approval": {
      "classes": [
        "P6",
        "P7"
      ],
      "options": {
        "a": {
          "live": false
        },
        "b": {
          "live": true,
          "exit_bar": null,
          "approval": "until_graduated",
          "graduation": "p6-p7-graduation",
          "veto_days": 3,
          "channel": "pr"
        },
        "c": {
          "live": true,
          "exit_bar": null,
          "approval": "per_promotion",
          "channel": "pr"
        },
        "d": {
          "live": true,
          "exit_bar": null,
          "approval": "none",
          "channel": "pr"
        },
        "e": {
          "per_class": {
            "P6": {
              "live": true,
              "exit_bar": null,
              "approval": "until_graduated",
              "graduation": "p6-p7-graduation",
              "veto_days": 3,
              "channel": "pr"
            },
            "P7": {
              "live": true,
              "exit_bar": null,
              "approval": "per_promotion",
              "channel": "pr"
            }
          }
        }
      }
    }
  },
  "exit_bars": {
    "p1-shadow-exit": {
      "description": "P1 leaves shadow after at least 4 weeks in shadow, at least 50 non-protected candidates judged, independent-judge precision of at least 0.90 on the sealed memory hold-out, and a contradiction-or-revert rate of at most 5% (lp-p1-memory-autopromote, options b and c).",
      "suite": "memory-holdout",
      "targets": {
        "shadow_days": {
          "min": 28
        },
        "judged": {
          "min": 50
        },
        "precision": {
          "min": 0.9
        },
        "contradiction_or_revert_rate": {
          "max": 0.05
        }
      }
    }
  },
  "graduations": {
    "p6-p7-graduation": {
      "description": "A class graduates once it has 3 approved promotions and 28 days have passed since the first of them, with no revert; a revert restarts the count.",
      "approved_min": 3,
      "days": 28,
      "revert_restarts": true
    }
  },
  "approval": {
    "grant": [
      "approve"
    ],
    "deny": [
      "decline"
    ]
  },
  "veto": {
    "veto": [
      "veto"
    ],
    "allow": [
      "allow"
    ]
  },
  "destinations": {
    "description": "Where each class may write. A destination's class is the lowest class whose allowlist admits it; a destination on no allowlist is P8. The fold is pure, so the applier also refuses a path with a symlink or junction on any segment, a path that resolves outside its repository, and any write the rendered bytes do not hash to.",
    "default_class": "P8",
    "allow": [
      {
        "class": "P1",
        "repo": "^(Chris0Jeky/)?claude-config$",
        "path": "^projects/[a-z0-9][a-z0-9._-]{0,79}/memory/(?![Mm][Ee][Mm][Oo][Rr][Yy]\\.[Mm][Dd]$)[A-Za-z0-9][A-Za-z0-9._-]{0,120}\\.md$",
        "what": "one curated memory note, never the auto-loaded MEMORY.md index"
      },
      {
        "class": "P3",
        "repo": "^(Chris0Jeky/)?claude-config$",
        "path": "^skills/[a-z0-9][a-z0-9._-]{0,79}/SKILL\\.md$",
        "what": "one skill definition"
      },
      {
        "class": "P4",
        "repo": "^(Chris0Jeky/)?claude-config$",
        "path": "^muse/recipes/(?![Rr][Ee][Aa][Dd][Mm][Ee]\\.)[a-z0-9][a-z0-9._-]{0,79}\\.(md|json)$",
        "what": "one Muse recipe"
      },
      {
        "class": "P4",
        "repo": "^(Chris0Jeky/)?claude-config$",
        "path": "^muse/(coordinator-brief|coordinator-turn)\\.md$",
        "what": "a coordinator prompt"
      },
      {
        "class": "P5",
        "repo": "^(Chris0Jeky/)?claude-config$",
        "path": "^muse/agent-routes\\.json$",
        "what": "the routing table"
      },
      {
        "class": "P6",
        "repo": "^(Chris0Jeky/)?claude-config$",
        "path": "^tools/muse_coordinator\\.py$",
        "what": "the scheduler"
      },
      {
        "class": "P7",
        "repo": "^(Chris0Jeky/)?claude-config$",
        "path": "^tools/[a-z0-9][a-z0-9_-]{0,79}[.](py|ps1)$",
        "what": "one tool script (the scheduler itself is P6)"
      },
      {
        "class": "P7",
        "repo": "^(Chris0Jeky/)?agent-harness$",
        "path": "^scripts/[a-z0-9][a-z0-9_]{0,79}[.]py$",
        "what": "one harness script (never the hook templates)"
      }
    ]
  },
  "content": {
    "description": "Authority or permission language anywhere in a candidate's claim, future decision, context or destination makes it P8: it touches who may do what, so it is never automatic. Matched case-insensitively; an error in a pattern fails closed to P8.",
    "class": "P8",
    "patterns": [
      "\\bpermissions?\\b",
      "\\bauthori[sz](e|ed|es|ation|ing)\\b",
      "\\bapprov(e|ed|es|al|ing)\\b",
      "\\bbypass",
      "\\boverrid(e|es|ing|den)\\b",
      "\\bskip(s|ped|ping)? (the |a |any )?(review|gate|check|test|hook)s?\\b",
      "--no-verify",
      "--force\\b",
      "\\bforce[- ]?push",
      "\\bwithout (a |any )?(review|approval|asking|permission)\\b",
      "\\b(merge|push)(es|ed|ing)? (it )?(straight|directly) to (main|master)\\b",
      "\\b(review|merge|tier|deny) gate\\b",
      "\\bdeny[- ]floor\\b",
      "\\btier\\.json\\b",
      "\\blaws?\\.md\\b",
      "(^|[\\s/`'\\\"])rules/",
      "\\bsettings(\\.local)?\\.json\\b",
      "(^|[\\s/`'\\\"])hooks?/",
      "\\ballow[- ]?list\\b",
      "\\bsudo\\b",
      "\\badministrator\\b",
      "\\bsecrets?\\b",
      "\\bcredentials?\\b",
      "\\bapi[ _-]?keys?\\b",
      "\\b(access|auth|bearer|session) tokens?\\b",
      "\\bestop\\b",
      "\\bkill[- ]?switch\\b",
      "\\bignore (all |any )?(previous|prior|above|earlier) instructions\\b",
      "\\bdisregard (all |any )?(previous|prior|above|earlier)? ?instructions\\b",
      "\\byou (must|should) now\\b",
      "\\bsystem prompt\\b"
    ]
  }
}
