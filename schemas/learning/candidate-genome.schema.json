{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Chris0Jeky/agent-harness/main/schemas/learning/candidate-genome.schema.json",
  "title": "candidate-genome/v1",
  "description": "A versioned change set for the higher layers. parent pins the estate it was cut from; parent_genome makes the variant archive a tree, not a single lineage. Most variants change one layer, which keeps attribution clean. Contract: SPECS.md section 15.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "at", "producer", "parent", "parent_genome", "changes",
    "candidates", "training_evidence"
  ],
  "properties": {
    "schema": {"const": "candidate-genome/v1"},
    "id": {"$ref": "common.schema.json#/$defs/gen_id"},
    "at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "producer": {"$ref": "common.schema.json#/$defs/producer"},
    "parent": {"$ref": "#/$defs/sha_set"},
    "parent_genome": {
      "anyOf": [{"$ref": "common.schema.json#/$defs/gen_id"}, {"type": "null"}]
    },
    "changes": {
      "description": "Per-layer file changes.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "common.schema.json#/$defs/layer"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repo", "path", "op"],
          "properties": {
            "repo": {"$ref": "common.schema.json#/$defs/repo"},
            "path": {"$ref": "common.schema.json#/$defs/relpath"},
            "op": {"type": "string", "enum": ["add", "modify", "delete"]},
            "after_sha256": {
              "anyOf": [
                {"$ref": "common.schema.json#/$defs/sha256"},
                {"type": "null"}
              ]
            }
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/lc_id"}
    },
    "training_evidence": {
      "description": "Everything the variant was generated from. The replay evaluator must exclude all of it from the variant's evaluation; the fold sees only the candidate's evidence.",
      "type": "object",
      "additionalProperties": false,
      "required": ["experiences"],
      "properties": {
        "experiences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/exp_id"}
        },
        "ledger": {
          "description": "outcome-ledger/v1 ids (findings, jobs) the variant was generated from.",
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "evaluation": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["suite", "baseline", "holdout_digest", "result_ref"],
          "properties": {
            "suite": {"$ref": "common.schema.json#/$defs/slug"},
            "baseline": {
              "anyOf": [
                {"$ref": "#/$defs/sha_set"},
                {"$ref": "common.schema.json#/$defs/gen_id"}
              ]
            },
            "holdout_digest": {"$ref": "common.schema.json#/$defs/sha256"},
            "result_ref": {"$ref": "common.schema.json#/$defs/ref"}
          }
        },
        {"type": "null"}
      ]
    },
    "objectives": {
      "description": "Measured objective values for the Pareto archive. Directions: correctness and reliability are maximised; cost, latency, owner_intervention and reverts are minimised.",
      "type": "object",
      "propertyNames": {
        "enum": [
          "correctness", "reliability", "cost", "latency",
          "owner_intervention", "reverts"
        ]
      },
      "additionalProperties": {"type": "number"}
    },
    "ext": {"$ref": "common.schema.json#/$defs/ext"}
  },
  "$defs": {
    "sha_set": {
      "description": "Estate commit set: repository -> commit SHA.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "common.schema.json#/$defs/repo"},
      "additionalProperties": {"$ref": "common.schema.json#/$defs/sha"}
    }
  }
}
