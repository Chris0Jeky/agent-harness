{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "expected=b3cf0c940f09136a6ed00d46565ab0b4d74b2b99eea864cdd88700a03d3dbbb9; python3 \"$HOME/.claude/hooks/dispatch.py\" --event pre --runtime codex",
            "commandWindows": "$expected='b3cf0c940f09136a6ed00d46565ab0b4d74b2b99eea864cdd88700a03d3dbbb9'; py -3 $env:USERPROFILE/.claude/hooks/dispatch.py --event pre --runtime codex",
            "timeout": 5,
            "statusMessage": "Checking irreversible-command policy"
          }
        ]
      }
    ]
  }
}
