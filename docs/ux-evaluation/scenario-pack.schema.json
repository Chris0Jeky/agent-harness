{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-harness:ux-scenario-pack:0",
  "title": "UX scenario authoring pack v0 (not a run receipt)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "pack_id", "status", "authority", "gate_eligible", "local_only", "subject", "journeys"],
  "properties": {
    "schema": {"const": "ux-scenario-pack/0"},
    "pack_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
    "status": {"const": "draft"},
    "authority": {"const": "advisory"},
    "gate_eligible": {"const": false},
    "local_only": {"const": true},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "source_revision"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "journeys": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/journey"}}
  },
  "$defs": {
    "strings": {"type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "journey": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "goal", "fixture_ref", "preconditions", "steps", "rubric_dimensions", "budget"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
        "goal": {"type": "string", "minLength": 1, "maxLength": 2000},
        "fixture_ref": {"type": "string", "minLength": 1, "maxLength": 2000},
        "preconditions": {"$ref": "#/$defs/strings"},
        "steps": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"$ref": "#/$defs/step"}},
        "rubric_dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["effectiveness", "usability", "simplicity", "clarity", "feel"]}},
        "budget": {
          "type": "object", "additionalProperties": false,
          "required": ["max_actions", "max_seconds", "max_judge_calls", "max_retries"],
          "properties": {
            "max_actions": {"type": "integer", "minimum": 1, "maximum": 100},
            "max_seconds": {"type": "integer", "minimum": 1, "maximum": 1800},
            "max_judge_calls": {"type": "integer", "minimum": 0, "maximum": 5},
            "max_retries": {"type": "integer", "minimum": 0, "maximum": 2}
          }
        }
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "action", "assertions", "evidence_required"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"},
        "action": {"type": "string", "minLength": 1, "maxLength": 2000},
        "assertions": {"$ref": "#/$defs/strings"},
        "evidence_required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["action_log", "screenshot", "trace", "video", "network_summary", "persisted_state"]}}
      }
    }
  }
}
